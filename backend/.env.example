# Copy to .env for local development. Never commit the real .env.

# Postgres connection string (Supabase gives you this in Project Settings > Database).
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/expenses

# Secret used to sign JWTs. Generate a real random value for anything beyond local dev,
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me

# Minutes before an issued token expires.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call this API (the deployed frontend URL,
# plus the local Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Stale-approval alert thresholds, in days. See docs/decisions.md for why these are
# configurable rather than hardcoded.
STALE_ALERT_DAYS=3
STALE_ALERT_SNOOZE_DAYS=3
